# ============================================================
# HealthEngine Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Local Postgres (Docker) — start with: docker compose up -d
DATABASE_URL="postgresql://postgres:password@localhost:5432/healthengine"
# Production / hosted Postgres (e.g. Neon) — use only in deploy envs, not local .env
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Session secret — must be at least 32 characters long
# Generate one with: openssl rand -base64 32
SESSION_SECRET="your-super-secret-key-must-be-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================
# Resend — for real email delivery (production only)
# Leave these commented out in development; the mock mailer
# will log OTP codes to the console instead.
# Sign up at https://resend.com, verify your domain, then
# create an API key and paste it below.
# ============================================================
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="noreply@yourdomain.com"
